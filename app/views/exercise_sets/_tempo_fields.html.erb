<% focus_inputs = local_assigns.fetch(:focus_inputs, false) %>
<% select_on_focus = focus_inputs ? "this.select()" : nil %>
<% tempo_present = %i[tempo_eccentric tempo_pause_bottom tempo_concentric tempo_pause_top].any? { |field| form.object.public_send(field).present? } %>

<details class="set-entry-disclosure" <%= "open" if tempo_present %>>
  <summary>
    <span><i class="bi bi-stopwatch me-2" aria-hidden="true"></i>Tempo</span>
    <span class="set-entry-disclosure__hint">4 phases <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i></span>
  </summary>
  <div class="set-entry-disclosure__body">
    <div class="set-entry-form__tempo-grid">
      <div>
        <label class="form-label small text-muted mb-1" title="Eccentric (lowering) phase in seconds">Eccentric</label>
        <%= form.number_field :tempo_eccentric,
            class: "form-control form-control-sm text-center",
            placeholder: "-", min: 0, max: 30,
            inputmode: "numeric", onfocus: select_on_focus %>
      </div>
      <div>
        <label class="form-label small text-muted mb-1" title="Pause at bottom or stretch position">Bottom</label>
        <%= form.number_field :tempo_pause_bottom,
            class: "form-control form-control-sm text-center",
            placeholder: "-", min: 0, max: 30,
            inputmode: "numeric", onfocus: select_on_focus %>
      </div>
      <div>
        <label class="form-label small text-muted mb-1" title="Concentric (lifting) phase in seconds">Concentric</label>
        <%= form.number_field :tempo_concentric,
            class: "form-control form-control-sm text-center",
            placeholder: "-", min: 0, max: 30,
            inputmode: "numeric", onfocus: select_on_focus %>
      </div>
      <div>
        <label class="form-label small text-muted mb-1" title="Pause at top or lockout position">Top</label>
        <%= form.number_field :tempo_pause_top,
            class: "form-control form-control-sm text-center",
            placeholder: "-", min: 0, max: 30,
            inputmode: "numeric", onfocus: select_on_focus %>
      </div>
    </div>
    <small class="text-muted d-block mt-2">Seconds per movement phase</small>
  </div>
</details>
