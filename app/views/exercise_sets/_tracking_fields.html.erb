<% focus_inputs = local_assigns.fetch(:focus_inputs, false) %>
<% select_on_focus = focus_inputs ? "this.select()" : nil %>
<% tracking_flags = %i[belt knee_sleeves wrist_wraps straps is_failed spotter_assisted pain_flag is_bfr] %>
<% tracking_values = %i[partial_reps pain_note band_tension_kg chain_weight_kg] %>
<% tracking_present = tracking_flags.any? { |field| form.object.public_send(field) } || tracking_values.any? { |field| form.object.public_send(field).present? } %>

<details class="set-entry-disclosure" <%= "open" if tracking_present %>>
  <summary>
    <span><i class="bi bi-gear me-2" aria-hidden="true"></i>Equipment &amp; Tracking</span>
    <span class="set-entry-disclosure__hint">Optional <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i></span>
  </summary>
  <div class="set-entry-disclosure__body">
    <div class="set-entry-option-grid mb-3">
      <% [
        [:belt, "Belt", nil],
        [:knee_sleeves, "Knee sleeves", nil],
        [:wrist_wraps, "Wrist wraps", nil],
        [:straps, "Straps", nil],
        [:is_failed, "Failed", "set-entry-option--danger"],
        [:spotter_assisted, "Spotter", nil],
        [:pain_flag, "Pain", "set-entry-option--danger"],
        [:is_bfr, "BFR", nil]
      ].each do |field, label, modifier| %>
        <label class="set-entry-option <%= modifier %>">
          <%= form.check_box field, class: "form-check-input" %>
          <span class="form-check-label"><%= label %></span>
        </label>
      <% end %>
    </div>

    <div class="set-entry-form__tracking-grid">
      <div>
        <label class="form-label small text-muted mb-1">Partials</label>
        <%= form.number_field :partial_reps,
            class: "form-control form-control-sm text-center",
            placeholder: "-", min: 1, inputmode: "numeric",
            onfocus: select_on_focus %>
      </div>
      <div class="set-entry-form__pain-note">
        <label class="form-label small text-muted mb-1">Pain note</label>
        <%= form.text_field :pain_note,
            class: "form-control form-control-sm",
            placeholder: "What hurts?" %>
      </div>
      <div>
        <label class="form-label small text-muted mb-1">Bands (<%= input_unit %>)</label>
        <%= form.number_field :band_tension_kg,
            class: "form-control form-control-sm text-center",
            placeholder: "-", step: "any", min: 0, inputmode: "decimal",
            onfocus: select_on_focus %>
      </div>
      <div>
        <label class="form-label small text-muted mb-1">Chains (<%= input_unit %>)</label>
        <%= form.number_field :chain_weight_kg,
            class: "form-control form-control-sm text-center",
            placeholder: "-", step: "any", min: 0, inputmode: "decimal",
            onfocus: select_on_focus %>
      </div>
    </div>
  </div>
</details>
