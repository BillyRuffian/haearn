<%= turbo_frame_tag set, data: { controller: "inline-set-edit", add_set_toggle_target: "editingForm" } do %>
  <% input_unit = input_weight_unit_for(workout_exercise) %>
  <%= form_with model: set, 
      url: workout_workout_exercise_exercise_set_path(workout, workout_exercise, set),
      method: :patch,
      class: "set-entry-form edit-set-form",
      data: { turbo_frame: dom_id(set) } do |form| %>
    <% weight_value = set.weight_kg ? input_weight_value_for(set.weight_kg, workout_exercise) : nil %>

    <div class="set-entry-form__header">
      <div>
        <span class="set-entry-form__context">Editing</span>
        <strong>Set <%= local_assigns[:index] || set.position %></strong>
      </div>
    </div>

    <% if set.errors.any? %>
      <div class="alert alert-danger py-2 mb-3" role="alert">
        <%= set.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= render "exercise_sets/fields",
        form: form,
        workout_exercise: workout_exercise,
        input_unit: input_unit,
        weight_value: weight_value %>

    <div class="set-entry-form__actions">
      <div class="set-entry-form__action-tools">
        <%= link_to "Cancel", workout_path(workout), class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
      </div>
      <%= form.button class: "btn btn-primary set-entry-form__submit" do %>
        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save set
      <% end %>
    </div>
  <% end %>
<% end %>
