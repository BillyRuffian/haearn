HAEARN
WEEKLY TRAINING REPORT

<%= @summary[:week_label] %>

Hey <%= @user.name %>, here is your week in training.
<% if @summary[:vs_average] %>
Compared with your previous <%= pluralize(@summary[:vs_average][:baseline_weeks], 'calendar week') %> of available history.
<% end %>

<% if @summary[:this_week][:workout_count] > 0 %>
THIS WEEK

Workouts: <%= @summary[:this_week][:workout_count] %>
<% if @summary[:vs_average] %>
  <%= weekly_summary_comparison(@summary[:vs_average][:workout_count_pct], @summary[:vs_average][:baseline_weeks]) %>
  Average: <%= weekly_summary_number(@summary[:vs_average][:avg_workout_count]) %>
<% end %>

Volume moved: <%= number_with_delimiter(WeightConverter.from_kg(@summary[:this_week][:total_volume_kg], @user.preferred_unit).round) %> <%= @user.preferred_unit %>
<% if @summary[:vs_average] %>
  <%= weekly_summary_comparison(@summary[:vs_average][:volume_pct], @summary[:vs_average][:baseline_weeks]) %>
  Average: <%= number_with_delimiter(WeightConverter.from_kg(@summary[:vs_average][:avg_volume_kg], @user.preferred_unit).round) %> <%= @user.preferred_unit %>
<% end %>

Working sets: <%= @summary[:this_week][:total_sets] %>
Total reps: <%= number_with_delimiter(@summary[:this_week][:total_reps]) %>
<% if @summary[:vs_average] %>
  <%= weekly_summary_comparison(@summary[:vs_average][:sets_pct], @summary[:vs_average][:baseline_weeks]) %>
  Average: <%= weekly_summary_number(@summary[:vs_average][:avg_sets]) %>
<% end %>

Training time: <%= weekly_summary_duration(@summary[:this_week][:total_duration_minutes]) %>
Exercises: <%= @summary[:this_week][:unique_exercises] %>
<% if @summary[:vs_average] %>
  <%= weekly_summary_comparison(@summary[:vs_average][:duration_pct], @summary[:vs_average][:baseline_weeks]) %>
  Average: <%= weekly_summary_duration(@summary[:vs_average][:avg_duration_minutes]) %>
<% end %>

<% if @summary[:highlights].any? %>
HIGHLIGHTS
<% @summary[:highlights].each do |highlight| %>
- <%= highlight[:message] %>
<% end %>

<% end %>
<% if @summary[:new_prs].any? %>
NEW PERSONAL RECORDS
<% @summary[:new_prs].each do |pr| %>
- <%= pr[:exercise_name] %>: <%= number_with_delimiter(WeightConverter.from_kg(pr[:value_kg], @user.preferred_unit).round) %> <%= @user.preferred_unit %> x <%= pr[:reps] %>
<% end %>

<% end %>
<% if @summary[:top_exercises].any? %>
TOP EXERCISES BY VOLUME
<% @summary[:top_exercises].each_with_index do |exercise, index| %>
<%= index + 1 %>. <%= exercise[:exercise_name] %>: <%= number_with_delimiter(WeightConverter.from_kg(exercise[:volume_kg], @user.preferred_unit).round) %> <%= @user.preferred_unit %> / <%= pluralize(exercise[:set_count], 'set') %>
<% end %>

<% end %>
<% if @summary[:consistency] %>
CONSISTENCY
Trained <%= @summary[:consistency][:weeks_trained_last_4] %> of the last 4 weeks
Current streak: <%= pluralize(@summary[:consistency][:current_streak], 'week') %>

<% end %>
Open your dashboard: <%= root_url %>
<% else %>
NO WORKOUTS LOGGED

A quiet week does not erase the work already done. Start the next session when you are ready.

Start a workout: <%= new_workout_url %>
<% end %>

