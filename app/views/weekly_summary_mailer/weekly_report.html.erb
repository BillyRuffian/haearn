<%
  stats = @summary[:this_week]
  comparison = @summary[:vs_average]
  baseline_weeks = comparison&.fetch(:baseline_weeks)
  unit = @user.preferred_unit
  display_volume = WeightConverter.from_kg(stats[:total_volume_kg], unit).round
%>
<span class="preheader">
  <%= stats[:workout_count] %> workouts, <%= number_with_delimiter(display_volume) %> <%= unit %> moved, <%= weekly_summary_duration(stats[:total_duration_minutes]) %> trained.
</span>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#0d0f10" style="width: 100%; background-color: #0d0f10;">
  <tr>
    <td class="email-outer" align="center" style="padding: 24px 12px;">
      <table role="presentation" class="email-shell" width="680" cellspacing="0" cellpadding="0" border="0" bgcolor="#171a1c" style="width: 100%; max-width: 680px; background-color: #171a1c; border: 1px solid #303438; border-radius: 8px; overflow: hidden;">
        <tr>
          <td class="email-gutter" style="padding: 24px 30px 20px; border-bottom: 3px solid #d8652f;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td class="mobile-full mobile-left" style="font-size: 20px; line-height: 24px; font-weight: 800; color: #ffffff; text-transform: uppercase; letter-spacing: 0;">Haearn</td>
                <td class="mobile-hide" align="right" style="font-size: 12px; line-height: 18px; font-weight: 700; color: #d8652f; text-transform: uppercase; letter-spacing: 0;">Weekly training report</td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td class="email-gutter" style="padding: 34px 30px 12px;">
            <p style="margin: 0 0 9px; font-size: 14px; line-height: 20px; color: #a7adb1;">Hey <%= @user.name %>, here is your week in training.</p>
            <h1 class="email-title" style="margin: 0; font-size: 34px; line-height: 40px; font-weight: 800; color: #ffffff; letter-spacing: 0;"><%= @summary[:week_label] %></h1>
            <% if comparison %>
              <p class="mobile-hide" style="margin: 10px 0 0; font-size: 13px; line-height: 20px; color: #8e969b;">Compared with your previous <%= pluralize(baseline_weeks, 'calendar week') %> of available history.</p>
              <p class="mobile-only-block" style="margin: 10px 0 0; font-size: 13px; line-height: 20px; color: #8e969b;">Compared with <%= pluralize(baseline_weeks, 'week') %> of history.</p>
            <% end %>
          </td>
        </tr>

        <% if stats[:workout_count] > 0 %>
          <tr>
            <td class="email-gutter" style="padding: 18px 22px 8px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td class="metric-cell" width="50%" valign="top" style="width: 50%; padding: 0 8px 16px;">
                    <table role="presentation" width="100%" height="166" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="height: 166px; background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                      <tr><td valign="top" style="padding: 19px 20px;">
                        <p style="margin: 0 0 12px; font-size: 12px; line-height: 16px; font-weight: 700; color: #a7adb1; text-transform: uppercase; letter-spacing: 0;">Workouts</p>
                        <p style="margin: 0; font-size: 36px; line-height: 40px; font-weight: 800; color: #ffffff;"><%= stats[:workout_count] %></p>
                        <% if comparison %>
                          <p class="<%= weekly_summary_trend_class(comparison[:workout_count_pct]) %>" style="margin: 10px 0 0; font-size: 13px; line-height: 18px; font-weight: 700;"><%= weekly_summary_comparison(comparison[:workout_count_pct], baseline_weeks) %></p>
                          <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;">Average <%= weekly_summary_number(comparison[:avg_workout_count]) %></p>
                        <% end %>
                      </td></tr>
                    </table>
                  </td>

                  <td class="metric-cell" width="50%" valign="top" style="width: 50%; padding: 0 8px 16px;">
                    <table role="presentation" width="100%" height="166" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="height: 166px; background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                      <tr><td valign="top" style="padding: 19px 20px;">
                        <p style="margin: 0 0 12px; font-size: 12px; line-height: 16px; font-weight: 700; color: #a7adb1; text-transform: uppercase; letter-spacing: 0;">Volume moved</p>
                        <p style="margin: 0; font-size: 36px; line-height: 40px; font-weight: 800; color: #d8652f;"><%= number_with_delimiter(display_volume) %> <span style="font-size: 15px; color: #a7adb1;"><%= unit %></span></p>
                        <% if comparison %>
                          <p class="<%= weekly_summary_trend_class(comparison[:volume_pct]) %>" style="margin: 10px 0 0; font-size: 13px; line-height: 18px; font-weight: 700;"><%= weekly_summary_comparison(comparison[:volume_pct], baseline_weeks) %></p>
                          <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;">Average <%= number_with_delimiter(WeightConverter.from_kg(comparison[:avg_volume_kg], unit).round) %> <%= unit %></p>
                        <% end %>
                      </td></tr>
                    </table>
                  </td>
                </tr>

                <tr>
                  <td class="metric-cell" width="50%" valign="top" style="width: 50%; padding: 0 8px 16px;">
                    <table role="presentation" width="100%" height="166" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="height: 166px; background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                      <tr><td valign="top" style="padding: 19px 20px;">
                        <p style="margin: 0 0 12px; font-size: 12px; line-height: 16px; font-weight: 700; color: #a7adb1; text-transform: uppercase; letter-spacing: 0;">Working sets</p>
                        <p style="margin: 0; font-size: 36px; line-height: 40px; font-weight: 800; color: #ffffff;"><%= stats[:total_sets] %></p>
                        <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;"><%= number_with_delimiter(stats[:total_reps]) %> total reps</p>
                        <% if comparison %>
                          <p class="<%= weekly_summary_trend_class(comparison[:sets_pct]) %>" style="margin: 7px 0 0; font-size: 13px; line-height: 18px; font-weight: 700;"><%= weekly_summary_comparison(comparison[:sets_pct], baseline_weeks) %></p>
                          <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;">Average <%= weekly_summary_number(comparison[:avg_sets]) %></p>
                        <% end %>
                      </td></tr>
                    </table>
                  </td>

                  <td class="metric-cell" width="50%" valign="top" style="width: 50%; padding: 0 8px 16px;">
                    <table role="presentation" width="100%" height="166" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="height: 166px; background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                      <tr><td valign="top" style="padding: 19px 20px;">
                        <p style="margin: 0 0 12px; font-size: 12px; line-height: 16px; font-weight: 700; color: #a7adb1; text-transform: uppercase; letter-spacing: 0;">Training time</p>
                        <p style="margin: 0; font-size: 36px; line-height: 40px; font-weight: 800; color: #ffffff;"><%= weekly_summary_duration(stats[:total_duration_minutes]) %></p>
                        <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;"><%= pluralize(stats[:unique_exercises], 'exercise') %></p>
                        <% if comparison %>
                          <p class="<%= weekly_summary_trend_class(comparison[:duration_pct]) %>" style="margin: 7px 0 0; font-size: 13px; line-height: 18px; font-weight: 700;"><%= weekly_summary_comparison(comparison[:duration_pct], baseline_weeks) %></p>
                          <p style="margin: 3px 0 0; font-size: 12px; line-height: 17px; color: #7f888d;">Average <%= weekly_summary_duration(comparison[:avg_duration_minutes]) %></p>
                        <% end %>
                      </td></tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <% if @summary[:highlights].any? %>
            <tr>
              <td class="email-gutter" style="padding: 18px 30px 0;">
                <h2 style="margin: 0 0 13px; font-size: 18px; line-height: 24px; color: #ffffff; letter-spacing: 0;">Highlights</h2>
                <% @summary[:highlights].each do |highlight| %>
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 8px; border-left: 3px solid <%= highlight[:type] == :missed_week ? '#d6a74f' : '#70c58b' %>;">
                    <tr><td bgcolor="#202427" style="padding: 13px 15px; background-color: #202427; font-size: 14px; line-height: 21px; color: #d9dddf;"><%= highlight[:message] %></td></tr>
                  </table>
                <% end %>
              </td>
            </tr>
          <% end %>

          <% if @summary[:new_prs].any? %>
            <tr>
              <td class="email-gutter" style="padding: 28px 30px 0;">
                <h2 style="margin: 0 0 13px; font-size: 18px; line-height: 24px; color: #ffffff; letter-spacing: 0;">New personal records</h2>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <% @summary[:new_prs].each do |pr| %>
                    <tr>
                      <td style="padding: 13px 0; border-top: 1px solid #303438; font-size: 15px; line-height: 21px; font-weight: 700; color: #ffffff;"><%= pr[:exercise_name] %></td>
                      <td align="right" style="padding: 13px 0; border-top: 1px solid #303438; font-size: 14px; line-height: 21px; color: #d8652f;"><%= number_with_delimiter(WeightConverter.from_kg(pr[:value_kg], unit).round) %> <%= unit %> &times; <%= pr[:reps] %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
            </tr>
          <% end %>

          <% if @summary[:top_exercises].any? %>
            <tr>
              <td class="email-gutter" style="padding: 28px 30px 0;">
                <h2 style="margin: 0 0 13px; font-size: 18px; line-height: 24px; color: #ffffff; letter-spacing: 0;">Top exercises by volume</h2>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <% @summary[:top_exercises].each_with_index do |exercise, index| %>
                    <tr>
                      <td width="34" valign="top" style="padding: 13px 10px 13px 0; border-top: 1px solid #303438; font-size: 12px; line-height: 21px; font-weight: 700; color: #7f888d;"><%= index + 1 %></td>
                      <td valign="top" style="padding: 13px 0; border-top: 1px solid #303438; font-size: 15px; line-height: 21px; font-weight: 700; color: #ffffff;"><%= exercise[:exercise_name] %><span class="mobile-only"><br><span style="font-size: 12px; font-weight: 400; color: #a7adb1;"><%= number_with_delimiter(WeightConverter.from_kg(exercise[:volume_kg], unit).round) %> <%= unit %> / <%= pluralize(exercise[:set_count], 'set') %></span></span></td>
                      <td class="mobile-hide" valign="top" align="right" style="padding: 13px 0 13px 12px; border-top: 1px solid #303438; font-size: 13px; line-height: 21px; color: #a7adb1;"><%= number_with_delimiter(WeightConverter.from_kg(exercise[:volume_kg], unit).round) %> <%= unit %> / <%= pluralize(exercise[:set_count], 'set') %></td>
                    </tr>
                  <% end %>
                </table>
              </td>
            </tr>
          <% end %>

          <% if @summary[:consistency] %>
            <tr>
              <td class="email-gutter" style="padding: 28px 30px 0;">
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                  <tr>
                    <td class="mobile-full mobile-left" style="padding: 17px 18px;">
                      <p style="margin: 0 0 4px; font-size: 12px; line-height: 17px; font-weight: 700; color: #a7adb1; text-transform: uppercase; letter-spacing: 0;">Consistency</p>
                      <p style="margin: 0; font-size: 15px; line-height: 21px; color: #ffffff;">Trained <%= @summary[:consistency][:weeks_trained_last_4] %> of the last 4 weeks<span class="mobile-only"><br><span style="font-size: 13px; color: #70c58b;"><%= pluralize(@summary[:consistency][:current_streak], 'week') %> streak</span></span></p>
                    </td>
                    <td class="mobile-hide" align="right" style="padding: 17px 18px;"><span style="font-size: 24px; line-height: 28px; font-weight: 800; color: #70c58b;"><%= @summary[:consistency][:current_streak] %></span> <span style="font-size: 13px; line-height: 20px; color: #a7adb1;">week streak</span></td>
                  </tr>
                </table>
              </td>
            </tr>
          <% end %>

          <tr>
            <td class="email-gutter" align="center" style="padding: 34px 30px 38px;">
              <a href="<%= root_url %>" class="cta-link" style="display: inline-block; padding: 14px 24px; background-color: #d8652f; border-radius: 6px; color: #ffffff; font-size: 14px; line-height: 18px; font-weight: 800; text-decoration: none; letter-spacing: 0;">Open your dashboard</a>
            </td>
          </tr>
        <% else %>
          <tr>
            <td class="email-gutter" style="padding: 24px 30px 40px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#202427" style="background-color: #202427; border: 1px solid #343a3e; border-radius: 6px;">
                <tr><td align="center" style="padding: 32px 22px;">
                  <p style="margin: 0 0 8px; font-size: 20px; line-height: 26px; font-weight: 800; color: #ffffff;">No workouts logged</p>
                  <p style="margin: 0 0 22px; font-size: 14px; line-height: 21px; color: #a7adb1;">A quiet week does not erase the work already done. Start the next session when you are ready.</p>
                  <a href="<%= new_workout_url %>" class="cta-link" style="display: inline-block; padding: 14px 24px; background-color: #d8652f; border-radius: 6px; color: #ffffff; font-size: 14px; line-height: 18px; font-weight: 800; text-decoration: none; letter-spacing: 0;">Start a workout</a>
                </td></tr>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td class="email-gutter" align="center" bgcolor="#111315" style="padding: 22px 30px; background-color: #111315; border-top: 1px solid #303438;">
            <p style="margin: 0 0 7px; font-size: 13px; line-height: 19px; font-weight: 700; color: #c3c8cb;">Haearn</p>
            <p style="margin: 0 0 9px; font-size: 12px; line-height: 18px; color: #747d82;">Hardcore weightlifting tracking</p>
            <p style="margin: 0; font-size: 12px; line-height: 18px;"><a href="<%= settings_url %>" style="color: #d98258; text-decoration: underline;">Manage email preferences</a></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
