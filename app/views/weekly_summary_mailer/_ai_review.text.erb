<% target = weekly_coaching_target(feedback, context) %>
<% if target.present? %>Next session: <%= target %><% end %>
<% end %>
<% if @weekly_coaching.fetch('weekly_observations').any? %>

ACROSS THE WEEK
<% @weekly_coaching.fetch('weekly_observations').each do |observation| %>
- <%= observation %>
<% end %>
<% end %>
<% if @weekly_coaching.fetch('next_week_priorities').any? %>

NEXT WEEK
<% @weekly_coaching.fetch('next_week_priorities').each do |priority| %>
- <%= priority %>
<% end %>
<% end %>
