<div data-controller="coaching-refresh"
     data-coaching-refresh-url-value="<%= workout_workout_analyses_path(workout) %>"
     data-action="online@window->coaching-refresh#resume focus@window->coaching-refresh#resume pageshow@window->coaching-refresh#resume visibilitychange@document->coaching-refresh#resume turbo:frame-load->coaching-refresh#frameLoaded">
  <%= turbo_stream_from workout, :coaching %>
  <%= render 'workout_analyses/signal', workout: workout %>
  <%= render 'workout_analyses/panel', workout: workout, analysis: analysis, live: local_assigns.fetch(:live, true) %>
</div>
