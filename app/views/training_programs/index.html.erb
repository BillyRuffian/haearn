<% content_for(:title) { "Programs | Haearn" } %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
      <p class="section-header mb-1">Training</p>
      <h1 class="display-heading mb-0">Programs</h1>
    </div>
    <%= link_to new_training_program_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-lg me-1"></i>New Program
    <% end %>
  </div>

  <% if @active_cycle %>
    <section class="program-active-band mb-4">
      <div>
        <span class="badge bg-success mb-2">Active</span>
        <h2 class="h4 mb-1"><%= @active_cycle.training_program.name %></h2>
        <p class="text-muted mb-0">
          Week <%= @active_cycle.week_number_on(Date.current) || @active_cycle.weeks_count %> of <%= @active_cycle.weeks_count %>
          &middot; ends <%= @active_cycle.ends_on.to_fs(:long) %>
        </p>
      </div>
      <%= link_to today_session_path, class: "btn btn-primary" do %>
        <i class="bi bi-calendar-check me-1"></i>Today
      <% end %>
    </section>
  <% end %>

  <% if @training_programs.any? %>
    <div class="row g-3">
      <% @training_programs.each do |program| %>
        <% latest_cycle = program.program_cycles.max_by(&:starts_on) %>
        <div class="col-12 col-md-6 col-xl-4">
          <article class="card h-100 program-card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <h2 class="h5 mb-0"><%= link_to program.name, program, class: "text-decoration-none" %></h2>
                <span class="badge bg-iron-light"><%= pluralize(program.weeks_count, "week") %></span>
              </div>
              <% if program.description.present? %>
                <p class="text-muted small"><%= truncate(program.description, length: 120) %></p>
              <% end %>
              <div class="d-flex gap-3 small text-muted mt-3">
                <span><i class="bi bi-calendar3 me-1"></i><%= pluralize(program.program_sessions.size, "session") %></span>
                <% if latest_cycle %>
                  <span><i class="bi bi-clock-history me-1"></i><%= latest_cycle.status.titleize %></span>
                <% end %>
              </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
              <span class="small text-muted">Updated <%= time_ago_in_words(program.updated_at) %> ago</span>
              <%= link_to program, class: "btn btn-sm btn-outline-secondary", title: "Open program" do %>
                <i class="bi bi-arrow-right"></i>
              <% end %>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state py-5 text-center">
      <i class="bi bi-calendar2-week display-1 text-muted"></i>
      <h2 class="h4 mt-3">No programs yet</h2>
      <%= link_to "Build Program", new_training_program_path, class: "btn btn-primary mt-3" %>
    </div>
  <% end %>
</div>
