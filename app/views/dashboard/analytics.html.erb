<div class="container py-4 analytics-page">
  <% if Current.user %>
    <header class="analytics-hero mb-4">
      <div>
        <p class="section-header mb-1">Training intelligence</p>
        <h1 class="display-heading mb-1"><i class="bi bi-graph-up-arrow me-2"></i>Analytics</h1>
        <p class="analytics-definition mb-0">
          Trends use completed workouts. Load volume means external weight × reps from working sets; warm-ups and time/distance work are excluded.
        </p>
      </div>
      <%= link_to root_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Overview
      <% end %>
    </header>

    <nav class="analytics-nav mb-4" aria-label="Analytics sections">
      <a href="#training-load">Training load</a>
      <a href="#progress">Progress</a>
      <a href="#strength-profile">Strength profile</a>
      <a href="#muscle-training">Muscle training</a>
      <a href="#history-signals">History signals</a>
    </nav>

    <%= render "analytics_panels" %>
  <% end %>
</div>
