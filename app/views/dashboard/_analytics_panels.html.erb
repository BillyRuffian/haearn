    <!-- Training Period Totals -->
    <% if @training_period_totals.present? %>
    <div class="row mt-5" id="training-load">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-minecart-loaded me-2"></i>Training Load
              <small class="text-muted ms-2">Working load volume and elapsed session time by analyzed period</small>
            </h5>
            <div class="row g-3">
              <% @training_period_totals.each do |period| %>
                <div class="col-sm-6 col-xl">
                  <div class="p-3 h-100 rounded" style="background: rgba(255, 107, 53, 0.08); border: 1px solid rgba(255, 107, 53, 0.18);">
                    <div class="stat-label mb-2"><%= period[:label] %></div>
                    <div class="d-flex align-items-baseline gap-1 mb-2">
                      <span class="h3 weight-display text-forge mb-0"><%= number_to_si(period[:volume]) %></span>
                      <span class="text-muted small"><%= Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-1 mb-2">
                      <span class="h5 weight-display text-iron mb-0"><%= period[:duration_label] %></span>
                      <span class="text-muted small">training</span>
                    </div>
                    <div class="text-muted small">
                      <i class="bi bi-calendar-range me-1"></i><%= period[:range_label] %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Current status -->
    <section class="row g-3 mt-4" aria-labelledby="current-status-heading">
      <h2 id="current-status-heading" class="visually-hidden">Current training status</h2>
      <div class="col-sm-4">
        <div class="card analytics-card h-100"><div class="card-body py-3">
          <div class="stat-label">Week to date</div>
          <div class="h3 weight-display text-forge mb-1"><%= @week_comparison_data[:this_week][:workouts] %></div>
          <div class="analytics-caption">completed sessions · <%= @week_comparison_data[:this_week][:range_label] %></div>
        </div></div>
      </div>
      <div class="col-sm-4">
        <div class="card analytics-card h-100"><div class="card-body py-3">
          <div class="stat-label">Consecutive-week streak</div>
          <div class="h3 weight-display text-iron mb-1"><%= @streak_data[:current] %></div>
          <div class="analytics-caption">weeks with at least one completed session</div>
        </div></div>
      </div>
      <div class="col-sm-4">
        <div class="card analytics-card h-100"><div class="card-body py-3">
          <div class="stat-label">Last completed session</div>
          <div class="h3 weight-display mb-1"><%= @streak_data[:last_workout_days_ago].nil? ? '—' : @streak_data[:last_workout_days_ago] %></div>
          <div class="analytics-caption"><%= @streak_data[:last_workout_days_ago].nil? ? 'No completed workout yet' : 'calendar days ago' %></div>
        </div></div>
      </div>
    </section>

    <!-- Workout Frequency Chart -->
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header"><i class="bi bi-bar-chart me-2"></i>Completed Workouts by Week <small class="text-muted ms-2">Last 8 calendar weeks</small></h5>
            <div data-controller="chart"
                 data-chart-type-value="bar"
                 data-chart-labels-value="<%= @workout_frequency.map { |w| w[:label] }.to_json %>"
                 data-chart-points-value="<%= @workout_frequency.map { |w| w[:count] }.to_json %>"
                 data-chart-label-value="Workouts"
                 data-chart-color-value="#ff6b35"
                 class="analytics-chart"
                 role="img" aria-label="Completed workouts in each of the last eight calendar weeks">
              <canvas data-chart-target="canvas">Completed workout counts by week.</canvas>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Workout Consistency -->
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-calendar3 me-2"></i>Training Cadence <small class="text-muted ms-2">Weekly consistency and preferred training days</small>
            </h5>
            
            <div class="row g-4">
              <!-- Last 12 Weeks -->
              <div class="col-lg-7">
                <h6 class="text-muted small mb-3">Last 12 Weeks</h6>
                <div role="img" aria-label="Completed workout count for each of the last twelve calendar weeks" style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; align-items: end; height: 120px;">
                  <% max_count = [@consistency_data[:twelve_weeks].map { |w| w[:count] }.max, 1].max %>
                  <% @consistency_data[:twelve_weeks].each do |week| %>
                    <div style="position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end;">
                      <% if week[:count] > 0 %>
                        <div class="text-center mb-1 chart-label">
                          <%= week[:count] %>
                        </div>
                      <% end %>
                      <div style="
                        height: <%= week[:count] == 0 ? '4px' : "#{(week[:count].to_f / max_count * 100).round}%" %>;
                        background: <%= week[:count] == 0 ? 'rgba(255,255,255,0.05)' : week[:count] >= 4 ? '#3d7ea6' : week[:count] >= 3 ? '#ff6b35' : week[:count] >= 2 ? '#b8860b' : '#71797E' %>;
                        border-radius: 3px;
                        min-height: 4px;"
                        aria-label="Week of <%= week[:week_start] %>: <%= pluralize(week[:count], 'completed workout') %>"
                        title="<%= week[:week_start] %>: <%= pluralize(week[:count], 'workout') %>">
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="d-flex justify-content-between mt-2 chart-axis-label">
                  <span><%= @consistency_data[:twelve_weeks].first[:week_start] %></span>
                  <span><%= @consistency_data[:twelve_weeks].last[:week_start] %></span>
                </div>
                <div class="mt-3 d-flex gap-2 flex-wrap chart-label">
                  <span class="text-muted">Legend:</span>
                  <span><span style="display: inline-block; width: 12px; height: 12px; background: #71797E; border-radius: 2px; vertical-align: middle;"></span> 1</span>
                  <span><span style="display: inline-block; width: 12px; height: 12px; background: #b8860b; border-radius: 2px; vertical-align: middle;"></span> 2</span>
                  <span><span style="display: inline-block; width: 12px; height: 12px; background: #ff6b35; border-radius: 2px; vertical-align: middle;"></span> 3</span>
                  <span><span style="display: inline-block; width: 12px; height: 12px; background: #3d7ea6; border-radius: 2px; vertical-align: middle;"></span> 4+</span>
                </div>
              </div>

              <!-- Day of Week Pattern -->
              <div class="col-lg-5">
                <h6 class="text-muted small mb-3">Training Days <span class="text-muted">(Last 90 days)</span></h6>
                <div class="d-flex flex-column gap-2" role="img" aria-label="Completed workout counts by day of week over the last ninety days">
                  <% max_day_count = [@consistency_data[:day_pattern].map { |d| d[:count] }.max, 1].max %>
                  <% @consistency_data[:day_pattern].each do |day| %>
                    <div class="d-flex align-items-center">
                      <div style="width: 35px;" class="text-muted small"><%= day[:day] %></div>
                      <div class="flex-fill" style="height: 16px; background: rgba(255,255,255,0.03); border-radius: 2px; position: relative; overflow: hidden;">
                        <% if day[:count] > 0 %>
                          <div style="
                            width: <%= (day[:count].to_f / max_day_count * 100).round %>%;
                            height: 100%;
                            background: #ff6b35;
                            border-radius: 2px;
                            transition: all 0.3s;"
                            title="<%= pluralize(day[:count], 'workout') %> on <%= day[:day] %>s">
                          </div>
                        <% end %>
                      </div>
                      <div style="width: 30px; text-align: right;" class="ms-2 text-muted small"><%= day[:count] %></div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PR Timeline -->
    <% if @pr_timeline_data.present? && @pr_timeline_data.any? %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-trophy me-2"></i>Personal Record Timeline <small class="text-muted ms-2">Heavier sets and best single-set load · last 12 months</small>
            </h5>
            <div data-controller="pr-timeline"
                 data-pr-timeline-data-value="<%= @pr_timeline_data.to_json %>"
                 data-pr-timeline-unit-value="<%= Current.user.preferred_unit %>"
                 data-pr-timeline-volume-unit-value="<%= Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %>"
                 class="analytics-chart analytics-chart--ranking"
                 style="--analytics-chart-height: <%= [240, 70 + (@pr_timeline_data.map { |pr| pr[:context] }.uniq.count * 32)].max %>px;"
                 role="img" aria-label="Personal record events by exact exercise and equipment context">
              <canvas data-pr-timeline-target="canvas">Personal records by date and exercise context.</canvas>
            </div>
            <p class="analytics-caption mb-0">Each marker has equal visual weight. Orange marks a heavier working set; gold marks a higher single-set load volume.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent PRs Table -->
    <%# Group PRs by exercise+date to combine weight and volume PRs on same day %>
    <% 
      grouped_prs = @pr_timeline_data.group_by { |pr| [pr[:context], pr[:date]] }
        .transform_values do |prs|
          {
            exercise: prs.first[:context],
            date: prs.first[:date],
            weight: prs.find { |p| p[:type] == 'weight' }&.dig(:weight),
            weight_reps: prs.find { |p| p[:type] == 'weight' }&.dig(:reps),
            volume: prs.find { |p| p[:type] == 'volume' },
            has_weight_pr: prs.any? { |p| p[:type] == 'weight' },
            has_volume_pr: prs.any? { |p| p[:type] == 'volume' }
          }
        end.values
        .sort_by { |pr| pr[:date] }
        .last(10)
        .reverse
    %>
    <% if grouped_prs.any? %>
      <div class="row mt-4">
        <div class="col-12">
          <div class="card position-relative analytics-card">
            <div class="card-body py-4">
              <h5 class="section-header">
                <i class="bi bi-list-ol me-2"></i>Recent Personal Records
              </h5>
              <div class="table-responsive analytics-table-wrap">
                <table class="table table-dark table-hover mb-0">
                  <thead>
                    <tr class="table-header-sm">
                      <th>Exercise</th>
                      <th class="text-end">Weight</th>
                      <th class="text-end">Reps</th>
                      <th class="text-center">Type</th>
                      <th class="text-end">Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% grouped_prs.each do |pr| %>
                      <tr>
                        <td class="fw-bold"><%= pr[:exercise] %></td>
                        <td class="text-end">
                          <span class="weight-display text-forge"><%= pr[:weight] || pr[:volume]&.dig(:weight) %></span>
                          <span class="text-muted small"><%= Current.user.preferred_unit %></span>
                        </td>
                        <td class="text-end"><%= pr[:weight_reps] || pr[:volume]&.dig(:reps) %></td>
                        <td class="text-center">
                          <% if pr[:has_weight_pr] && pr[:has_volume_pr] %>
                            <span class="badge badge-sm bg-forge me-1">
                              <i class="bi bi-arrow-up"></i> HEAVIER
                            </span>
                            <span class="badge badge-sm bg-iron">
                              <i class="bi bi-graph-up"></i> SET LOAD
                            </span>
                          <% elsif pr[:has_weight_pr] %>
                            <span class="badge badge-sm bg-forge">
                              <i class="bi bi-arrow-up"></i> HEAVIER
                            </span>
                          <% else %>
                            <span class="badge badge-sm bg-iron">
                              <i class="bi bi-graph-up"></i> SET LOAD
                            </span>
                          <% end %>
                        </td>
                        <td class="text-end text-muted small">
                          <%= Date.parse(pr[:date]).strftime("%b %d") %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <% end %>

    <!-- Rep Range Distribution -->
    <div class="row mt-4" id="progress">
    <% if @rep_range_data.values.sum > 0 %>
      <div class="col-md-6">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-bar-chart-steps me-2"></i>Working Rep-Set Distribution
              <small class="text-muted ms-2">Last 30 days</small>
            </h5>
            <div data-controller="rep-range-chart"
                 data-rep-range-chart-data-value="<%= @rep_range_data.to_json %>"
                 class="analytics-chart analytics-chart--compact"
                 role="img" aria-label="Working set counts in four rep ranges over the last 30 days">
              <canvas data-rep-range-chart-target="canvas">Working set counts by repetition range.</canvas>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-info-circle me-2"></i>Training Zones
            </h5>
            <div class="small">
              <div class="d-flex align-items-center mb-2">
                <span class="badge me-2" style="background: #a33a0c; width: 60px;">1-5</span>
                <span class="text-muted">Commonly used for heavier strength work</span>
              </div>
              <div class="d-flex align-items-center mb-2">
                <span class="badge me-2" style="background: #ff6b35; width: 60px;">6-10</span>
                <span class="text-muted">Commonly used for moderate-rep work</span>
              </div>
              <div class="d-flex align-items-center mb-2">
                <span class="badge me-2" style="background: #f0a060; width: 60px;">11-15</span>
                <span class="text-muted">Commonly used for higher-rep work</span>
              </div>
              <div class="d-flex align-items-center">
                <span class="badge me-2" style="background: #71797E; width: 60px;">16+</span>
                <span class="text-muted">Very high-rep and conditioning work</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="col-12">
        <div class="analytics-empty">Complete weighted working sets to see rep-range and progress analysis.</div>
      </div>
    <% end %>
    </div>

    <!-- Session Duration Trends -->
    <% if @session_duration_data.length > 2 %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-clock-history me-2"></i>Completed Session Duration
              <small class="text-muted ms-2">Start-to-finish time · last <%= @session_duration_data.length %> sessions</small>
            </h5>
            <div data-controller="session-duration"
                 data-session-duration-data-value="<%= @session_duration_data.to_json %>"
                 class="analytics-chart"
                 role="img" aria-label="Elapsed duration of recent completed workout sessions">
              <canvas data-session-duration-target="canvas">Recent completed session durations in minutes.</canvas>
            </div>
            <div class="text-center mt-2">
              <small class="text-muted">
                Average: <%= (@session_duration_data.sum { |d| d[:duration] } / @session_duration_data.length.to_f).round %> min
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Training Density -->
    <% if @training_density_data.length > 2 %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-speedometer2 me-2"></i>Working Load per Minute
              <small class="text-muted ms-2">Last 20 completed sessions lasting at least 5 minutes</small>
            </h5>
            <div data-controller="chart"
                 data-chart-type-value="line"
                 data-chart-labels-value="<%= @training_density_data.map { |d| Date.parse(d[:date]).strftime('%b %d') }.to_json %>"
                 data-chart-points-value="<%= @training_density_data.map { |d| d[:density] }.to_json %>"
                 data-chart-label-value="<%= Current.user.preferred_unit == 'lbs' ? 'lb·reps/min' : 'kg·reps/min' %>"
                 data-chart-color-value="#71797E"
                 data-chart-fill-value="true"
                 class="analytics-chart analytics-chart--compact"
                 role="img" aria-label="Working set load volume per minute for recent completed sessions">
              <canvas data-chart-target="canvas">Working load volume per minute by session.</canvas>
            </div>
            <div class="text-center mt-2">
              <small class="text-muted">
                <% avg_density = (@training_density_data.sum { |d| d[:density] } / @training_density_data.length.to_f).round %>
                Average: <%= avg_density %> <%= Current.user.preferred_unit == 'lbs' ? 'lb·reps/min' : 'kg·reps/min' %>
                <span class="mx-2">•</span>
                Compare only broadly similar sessions
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Consistency Streaks & Week Comparison -->
    <div class="row mt-4 g-4">
      <!-- Consistency Streaks -->
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-fire me-2"></i>Consistency Streaks
            </h5>
            <div class="row text-center">
              <div class="col-6">
                <div class="p-3 rounded" style="background: rgba(255, 107, 53, 0.1);">
                  <div class="display-4 weight-display text-forge mb-1">
                    <%= @streak_data[:current] %>
                  </div>
                  <p class="stat-label">
                    Current Streak
                  </p>
                  <p class="text-muted small mb-0">(weeks)</p>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 rounded" style="background: rgba(113, 121, 126, 0.1);">
                  <div class="display-4 weight-display text-iron mb-1">
                    <%= @streak_data[:longest] %>
                  </div>
                  <p class="stat-label">
                    Longest Streak
                  </p>
                  <p class="text-muted small mb-0">(weeks)</p>
                </div>
              </div>
            </div>
            <% if @streak_data[:last_workout_days_ago] %>
              <div class="text-center mt-3">
                <small class="text-muted">
                  <% if @streak_data[:last_workout_days_ago] == 0 %>
                    <i class="bi bi-lightning-charge text-forge"></i> You worked out today!
                  <% elsif @streak_data[:last_workout_days_ago] == 1 %>
                    <i class="bi bi-check-circle text-success"></i> Last workout: yesterday
                  <% elsif @streak_data[:last_workout_days_ago] <= 3 %>
                    <i class="bi bi-check-circle text-success"></i> Last workout: <%= @streak_data[:last_workout_days_ago] %> days ago
                  <% elsif @streak_data[:last_workout_days_ago] <= 7 %>
                    <i class="bi bi-exclamation-triangle text-warning"></i> Last workout: <%= @streak_data[:last_workout_days_ago] %> days ago
                  <% else %>
                    <i class="bi bi-exclamation-circle text-danger"></i> Last workout: <%= @streak_data[:last_workout_days_ago] %> days ago
                  <% end %>
                </small>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Week-over-Week Comparison -->
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-arrow-left-right me-2"></i>Week to Date <small class="text-muted ms-2">Compared with the same elapsed period last week</small>
            </h5>
            <div class="table-responsive analytics-table-wrap">
              <table class="table table-dark table-sm mb-0">
                <thead>
                  <tr class="table-header-sm">
                    <th></th>
                    <th class="text-end">This week<br><small class="text-muted"><%= @week_comparison_data[:this_week][:range_label] %></small></th>
                    <th class="text-end">Last week<br><small class="text-muted"><%= @week_comparison_data[:last_week][:range_label] %></small></th>
                    <th class="text-end">Change</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="text-muted">Working load</td>
                    <td class="text-end">
                      <span class="weight-display"><%= number_to_si(@week_comparison_data[:this_week][:volume]) %></span>
                      <span class="text-muted small"><%= Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %></span>
                    </td>
                    <td class="text-end text-muted">
                      <%= number_to_si(@week_comparison_data[:last_week][:volume]) %>
                    </td>
                    <td class="text-end">
                      <% vol_diff = @week_comparison_data[:this_week][:volume] - @week_comparison_data[:last_week][:volume] %>
                      <% if @week_comparison_data[:last_week][:volume] > 0 %>
                        <% vol_pct = ((vol_diff.to_f / @week_comparison_data[:last_week][:volume]) * 100).round %>
                        <% if vol_diff > 0 %>
                          <span class="text-success"><i class="bi bi-arrow-up-short"></i><%= vol_pct %>%</span>
                        <% elsif vol_diff < 0 %>
                          <span class="text-danger"><i class="bi bi-arrow-down-short"></i><%= vol_pct.abs %>%</span>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <td class="text-muted">Workouts</td>
                    <td class="text-end weight-display"><%= @week_comparison_data[:this_week][:workouts] %></td>
                    <td class="text-end text-muted"><%= @week_comparison_data[:last_week][:workouts] %></td>
                    <td class="text-end">
                      <% wo_diff = @week_comparison_data[:this_week][:workouts] - @week_comparison_data[:last_week][:workouts] %>
                      <% if wo_diff > 0 %>
                        <span class="text-success"><i class="bi bi-arrow-up-short"></i><%= wo_diff %></span>
                      <% elsif wo_diff < 0 %>
                        <span class="text-danger"><i class="bi bi-arrow-down-short"></i><%= wo_diff.abs %></span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <td class="text-muted">Sets</td>
                    <td class="text-end weight-display"><%= @week_comparison_data[:this_week][:sets] %></td>
                    <td class="text-end text-muted"><%= @week_comparison_data[:last_week][:sets] %></td>
                    <td class="text-end">
                      <% set_diff = @week_comparison_data[:this_week][:sets] - @week_comparison_data[:last_week][:sets] %>
                      <% if set_diff > 0 %>
                        <span class="text-success"><i class="bi bi-arrow-up-short"></i><%= set_diff %></span>
                      <% elsif set_diff < 0 %>
                        <span class="text-danger"><i class="bi bi-arrow-down-short"></i><%= set_diff.abs %></span>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Strength & Volume Analytics -->
    <div class="row mt-4 g-4" id="strength-profile">
      <% if @strength_curve_data.any? %>
        <div class="col-12">
          <div class="card position-relative analytics-card"><div class="card-body py-4" data-controller="strength-curve" data-strength-curve-data-value="<%= @strength_curve_data.to_json %>" data-strength-curve-unit-value="<%= Current.user.preferred_unit %>">
            <h5 class="section-header"><i class="bi bi-graph-up-arrow me-2"></i>Best Logged Load by Rep Bucket <small class="text-muted ms-2">Exact exercise/equipment context · last 12 months</small></h5>
            <label for="strength-curve-context" class="form-label small text-muted">Exercise and equipment</label>
            <select id="strength-curve-context" class="form-select form-select-sm analytics-context-select mb-3" data-action="change->strength-curve#changeContext">
              <% @strength_curve_data.each_with_index do |context, index| %><option value="<%= index %>"><%= context[:name] %></option><% end %>
            </select>
            <div class="analytics-chart" role="img" aria-label="Best logged weight in each repetition bucket for the selected exact exercise and equipment context"><canvas data-strength-curve-target="canvas">Best logged load by repetition bucket.</canvas></div>
            <p class="analytics-caption mb-0 mt-2">Buckets with no qualifying working set are left blank; values are not interpolated.</p>
          </div></div>
        </div>
      <% end %>
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card"><div class="card-body py-4">
          <h5 class="section-header"><i class="bi bi-bar-chart me-2"></i>Primary-Muscle Load Distribution <small class="text-muted ms-2">Working weighted rep sets</small></h5>
          <% if @muscle_volume_distribution_data[:seven_days].any? || @muscle_volume_distribution_data[:thirty_days].any? %>
            <div data-controller="muscle-group-chart" data-muscle-group-chart-seven-days-value="<%= @muscle_volume_distribution_data[:seven_days].to_json %>" data-muscle-group-chart-thirty-days-value="<%= @muscle_volume_distribution_data[:thirty_days].to_json %>" data-muscle-group-chart-colors-value="<%= @muscle_volume_distribution_data[:colors].to_json %>" data-muscle-group-chart-labels-value="<%= @muscle_volume_distribution_data[:labels].to_json %>" data-muscle-group-chart-unit-value="<%= Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %>">
              <label for="muscle-volume-period" class="visually-hidden">Analysis period</label>
              <select id="muscle-volume-period" aria-label="Muscle load distribution period" class="form-select form-select-sm mb-2" data-muscle-group-chart-target="periodSelect" data-action="change->muscle-group-chart#changePeriod"><option value="seven_days">Last 7 calendar days</option><option value="thirty_days">Last 30 calendar days</option></select>
              <div class="analytics-chart analytics-chart--tall" role="img" aria-label="Working load volume assigned to each exercise's primary muscle"><canvas data-muscle-group-chart-target="canvas">Working load volume by primary muscle group.</canvas></div>
            </div>
          <% else %><p class="text-muted small mb-0">Log completed weighted working sets to see volume by muscle group.</p><% end %>
        </div></div>
      </div>
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card"><div class="card-body py-4">
          <h5 class="section-header"><i class="bi bi-bar-chart me-2"></i>Relative Strength <small class="text-muted ms-2">Estimated 1RM divided by bodyweight</small></h5>
          <% if @lift_ratio_data[:values].any? %>
            <div data-controller="chart" data-chart-type-value="bar" data-chart-horizontal-value="true" data-chart-labels-value="<%= @lift_ratio_data[:labels].to_json %>" data-chart-points-value="<%= @lift_ratio_data[:values].to_json %>" data-chart-label-value="e1RM / bodyweight (×)" data-chart-color-value="#3d7ea6" class="analytics-chart" role="img" aria-label="Estimated one rep max divided by bodyweight for marked free-weight major lifts"><canvas data-chart-target="canvas">Relative strength ratios by major lift.</canvas></div>
            <p class="analytics-caption mb-0">Completed, non-warmup free-weight sets from explicitly marked major lifts. Ratios are training estimates.</p>
          <% else %><p class="text-muted small mb-0"><%= @lift_ratio_data[:reason] %></p><% end %>
        </div></div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-12"><div class="card position-relative analytics-card"><div class="card-body py-4">
        <h5 class="section-header"><i class="bi bi-trophy me-2"></i>Best-Known SBD Training Scores <small class="text-muted ms-2">Wilks and DOTS estimates over time</small></h5>
        <% if @strength_score_trend_data[:points].any? %>
          <div data-controller="chart" data-chart-type-value="line" data-chart-data-value="<%= { labels: @strength_score_trend_data[:points].map { |point| point[:date] }, datasets: [{ label: 'Wilks', data: @strength_score_trend_data[:points].map { |point| point[:wilks] }, borderColor: '#ff6b35', backgroundColor: 'rgba(255,107,53,.2)' }, { label: 'DOTS', data: @strength_score_trend_data[:points].map { |point| point[:dots] }, borderColor: '#3d7ea6', backgroundColor: 'rgba(61,126,166,.2)' }] }.to_json %>" class="analytics-chart analytics-chart--tall" role="img" aria-label="Wilks and DOTS training score estimates over time"><canvas data-chart-target="canvas">Wilks and DOTS training estimates over time.</canvas></div>
          <p class="analytics-caption mb-0">Best-known free-weight SBD e1RM total paired with a prior weigh-in no more than 30 days old. Training estimate—not a meet score.</p>
        <% else %><p class="text-muted small mb-0"><%= @strength_score_trend_data[:reason] %></p><% end %>
      </div></div></div>
    </div>

    <!-- Muscle Group Visualizations -->
    <div class="row mt-4 g-4" id="muscle-training">
    <% if @muscle_group_data.any? || @muscle_balance_data.any? %>
      <% if @muscle_group_data.any? %>
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-person-arms-up me-2"></i>Primary-Muscle Training Recency
              <small class="text-muted ms-2">Calendar days since last working set</small>
            </h5>

            <%# Color scale legend - compact inline %>
            <div class="d-flex align-items-center gap-1 mb-3 small">
              <span class="text-muted">Recent</span>
              <div class="recovery-scale-bar" aria-hidden="true"></div>
              <span class="text-muted">Longer ago</span>
            </div>

            <% 
              # Group muscles by body region for better visual organization
              upper_push = %w[chest shoulders triceps]
              upper_pull = %w[back biceps forearms]
              lower_core = %w[quadriceps hamstrings glutes calves core]
              regions = [
                { label: "Upper Push", groups: upper_push },
                { label: "Upper Pull", groups: upper_pull },
                { label: "Lower & Core", groups: lower_core }
              ]
            %>

            <% regions.each do |region| %>
              <% region_muscles = region[:groups].select { |mg| @muscle_group_data[mg] } %>
              <% next if region_muscles.empty? %>
              <div class="mb-3">
                <div class="stat-label mb-2">
                  <%= region[:label] %>
                </div>
                <% region_muscles.each do |muscle_group| %>
                  <% muscle_data = @muscle_group_data[muscle_group] %>
                  <% days_since = muscle_data[:days_since] %>
                  <%
                    # Recency bar: longer bars mean more calendar days since the last working set
                    recency_pct = [(days_since / 4.0 * 100), 100].min.round
                    bar_color = if days_since == 0
                      '#a33232'
                    elsif days_since == 1
                      '#b8860b'
                    elsif days_since <= 2
                      '#3d7ea6'
                    else
                      '#71797E'
                    end
                    status_text = if days_since == 0
                      'Today'
                    elsif days_since == 1
                      '1d'
                    elsif days_since < 7
                      "#{days_since}d"
                    else
                      '—'
                    end
                  %>
                  <div class="recovery-row d-flex align-items-center mb-1" role="img" aria-label="<%= Exercise::MUSCLE_GROUP_LABELS[muscle_group] %>: last trained <%= days_since == 0 ? 'today' : pluralize(days_since, 'calendar day') + ' ago' %>">
                    <span class="recovery-label" title="<%= Exercise::MUSCLE_GROUP_LABELS[muscle_group] %>"><%= Exercise::MUSCLE_GROUP_LABELS[muscle_group] %></span>
                    <div class="recovery-bar-track flex-grow-1 mx-2">
                      <div class="recovery-bar-fill" style="width: <%= recency_pct %>%; background: <%= bar_color %>;">
                      </div>
                    </div>
                    <span class="recovery-days" style="color: <%= bar_color %>"><%= status_text %></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <% end %>

      <!-- Muscle Balance Spider Chart -->
      <% if @muscle_balance_data.any? %>
      <div class="col-md-6">
        <div class="card position-relative h-100 analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-bar-chart me-2"></i>Share of Assigned Load
              <small class="text-muted ms-2">Percent of 30-day working load by primary muscle</small>
            </h5>
            <div data-controller="chart"
                 data-chart-type-value="bar"
                 data-chart-horizontal-value="true"
                 data-chart-labels-value="<%= @muscle_balance_data.sort_by { |d| -d[:value] }.map { |d| d[:muscle] }.to_json %>"
                 data-chart-points-value="<%= @muscle_balance_data.sort_by { |d| -d[:value] }.map { |d| d[:value] }.to_json %>"
                 data-chart-label-value="Share of assigned load (%)"
                 data-chart-color-value="#ff6b35"
                 class="analytics-chart analytics-chart--tall"
                 role="img" aria-label="Percent share of working load volume assigned to each primary muscle">
              <canvas data-chart-target="canvas">Share of assigned load by primary muscle.</canvas>
            </div>
            <div class="text-center mt-2">
              <small class="text-muted">This reflects each exercise’s assigned primary muscle, not total muscular contribution.</small>
            </div>
          </div>
        </div>
      </div>
      <% end %>
    <% else %>
      <div class="col-12">
        <div class="analytics-empty">Complete weighted working sets on exercises with a primary muscle to see recency and load-share analysis.</div>
      </div>
    <% end %>
    </div>

    <!-- Exercise Frequency Ranking -->
    <div class="row mt-4" id="history-signals">
    <% if @exercise_frequency_data.any? %>
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-bar-chart-line me-2"></i>Most Frequently Logged Exercises
              <small class="text-muted ms-2">Recorded exercise occurrences with at least one set · last 90 days</small>
            </h5>
            <div data-controller="chart"
                 data-chart-type-value="bar"
                 data-chart-labels-value="<%= @exercise_frequency_data.map { |d| d[:exercise] }.to_json %>"
                 data-chart-points-value="<%= @exercise_frequency_data.map { |d| d[:count] }.to_json %>"
                 data-chart-label-value="Logged occurrences"
                 data-chart-color-value="#ff6b35"
                 data-chart-horizontal-value="true"
                 class="analytics-chart analytics-chart--ranking"
                 style="--analytics-chart-height: <%= [220, @exercise_frequency_data.length * 34].max %>px;"
                 role="img" aria-label="Most frequently logged exercises in the last 90 days">
              <canvas data-chart-target="canvas">Exercise occurrence ranking.</canvas>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="col-12">
        <div class="analytics-empty">Record at least one set for an exercise to build frequency and history signals.</div>
      </div>
    <% end %>
    </div>

    <!-- Tonnage Tracker -->
    <% if @tonnage_data.any? && @tonnage_data.sum { |d| d[:volume] } > 0 %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative analytics-card">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-graph-up-arrow me-2"></i>Weekly Working Load
              <small class="text-muted ms-2">External load × reps · last 12 calendar weeks</small>
            </h5>
            <div data-controller="chart"
                 data-chart-type-value="line"
                 data-chart-labels-value="<%= @tonnage_data.map { |d| d[:label] }.to_json %>"
                 data-chart-points-value="<%= @tonnage_data.map { |d| d[:volume] }.to_json %>"
                 data-chart-label-value="Load volume (<%= Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %>)"
                 data-chart-color-value="#ff6b35"
                 data-chart-fill-value="true"
                 class="analytics-chart"
                 role="img" aria-label="Weekly working load volume over the last 12 calendar weeks">
              <canvas data-chart-target="canvas">Weekly working load volume.</canvas>
            </div>
            <div class="text-center mt-2">
              <small class="text-muted">
                <% total_tonnage = @tonnage_data.sum { |d| d[:volume] } %>
                <% avg_tonnage = (total_tonnage / @tonnage_data.length.to_f).round %>
                <% load_unit = Current.user.preferred_unit == 'lbs' ? 'lb·reps' : 'kg·reps' %>
                Total: <%= number_to_si(total_tonnage) %> <%= load_unit %> &middot;
                Average: <%= number_to_si(avg_tonnage) %> <%= load_unit %>/week
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>

    <!-- Plateau Detector -->
    <% if @plateau_data.any? %>
    <div class="row mt-4">
      <div class="col-12">
        <div class="card position-relative border-warning analytics-card" style="border-color: rgba(255, 193, 7, 0.3) !important;">
          <div class="card-body py-4">
            <h5 class="section-header">
              <i class="bi bi-exclamation-triangle text-warning me-2"></i>Plateau Alert
              <small class="text-muted ms-2">No heavier working set in 4+ weeks</small>
            </h5>
            <div class="table-responsive analytics-table-wrap">
              <table class="table table-dark table-sm mb-0">
                <thead>
                  <tr class="table-header-sm">
                    <th>Exercise</th>
                    <th class="text-center">Weeks Stuck</th>
                    <th class="text-end">Best Weight</th>
                    <th class="text-end">Last PR</th>
                  </tr>
                </thead>
                <tbody>
                  <% @plateau_data.each do |plateau| %>
                    <tr>
                      <td class="fw-bold"><%= plateau[:exercise] %></td>
                      <td class="text-center">
                        <span class="badge <%= plateau[:weeks_since_pr] >= 8 ? 'bg-danger' : 'bg-warning text-dark' %>">
                          <%= plateau[:weeks_since_pr] %> weeks
                        </span>
                      </td>
                      <td class="text-end">
                        <span class="weight-display"><%= plateau[:best_weight] %></span>
                        <span class="text-muted small"><%= Current.user.preferred_unit %></span>
                      </td>
                      <td class="text-end text-muted small"><%= plateau[:last_pr_date] %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <div class="mt-3">
              <small class="text-muted">
                <i class="bi bi-lightbulb me-1"></i>
                This is a heavier-set heuristic. Review the exact exercise history, rep ranges, fatigue, and training intent before changing the program.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% end %>
